+/// The findings for one shader: compiled again and set against the committed WGSL.
+fn judge(crate_name: &str, slang: &Path, wgsl: &Path) -> Vec<LintError> {
+    match compile(slang) {
+        Err(why) => vec![LintError::error(crate_name.to_string(), 0, NAME, why)],
+        Ok(fresh) => {
+            let committed = std::fs::read_to_string(wgsl).unwrap_or_default();
+            if fresh == committed {
+                return Vec::new();
+            }
+            vec![LintError::error(
+                crate_name.to_string(),
+                0,
+                NAME,
+                format!(
+                    "`{}` is stale against `{}`: compile it again with `slangc {} -target wgsl -entry vs -stage vertex -entry fs -stage fragment -o {}`",
+                    wgsl.display(),
+                    slang.display(),
+                    slang.display(),
+                    wgsl.display()
+                ),
+            )]
+        },
+    }
+}
+
+/// What the compiler on the path calls itself, so a changed compiler judges every shader again.
+fn slangc_version() -> String {
+    Command::new("slangc")
+        .arg("-v")
+        .output()
+        .map(|o| format!("{}{}", String::from_utf8_lossy(&o.stdout), String::from_utf8_lossy(&o.stderr)))
+        .unwrap_or_else(|e| format!("absent:{e}"))
+}
+
+/// The bytes of every `.slang` in the shader's directory, in name order.
+fn sibling_sources(slang: &Path) -> Vec<Vec<u8>> {
+    let dir = slang.parent().unwrap_or(Path::new("."));
+    let mut names: Vec<PathBuf> = std::fs::read_dir(dir)
+        .into_iter()
+        .flatten()
+        .flatten()
+        .map(|e| e.path())
+        .filter(|p| p.extension().is_some_and(|e| e == "slang"))
+        .collect();
+    names.sort();
+    names.iter().map(|p| std::fs::read(p).unwrap_or_default()).collect()
+}
